NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=letsgosport
DB_SSL=false
DB_CONNECTION_LIMIT=10

SESSION_SECRET=change-me-with-a-long-random-secret
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
PUBLIC_ORIGIN=http://localhost:3000
MESSAGE_RETENTION_DAYS=15

# Archiviazione upload in produzione: bucket S3/R2 privato oppure disco persistente.
# MEDIA_S3_BUCKET=
# MEDIA_S3_ENDPOINT=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_DIR=/var/data/uploads
# Tetto del bucket S3/R2 in byte decimali: predefinito 8 GB. Richiede CREATE sul DB.
# MEDIA_STORAGE_LIMIT_BYTES=8000000000

# Facoltativo: Cloudflare Realtime TURN. Chiave TURN dedicata, diversa dai token R2.
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
# TURN_ENABLED=true
# TURN_TTL_SECONDS=14400
# Per lo staging limitare il relay agli account di prova, separati da virgola.
# TURN_ALLOWED_EMAILS=primo@example.test,secondo@example.test

# In alternativa: relay coturn con credenziali temporanee (use-auth-secret).
# Più URL separati da virgola. In produzione includere TURN su TCP/TLS.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# TURN_SHARED_SECRET=
