NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=letsgosport
DB_SSL=false
DB_CONNECTION_LIMIT=10

SESSION_SECRET=change-me-with-a-long-random-secret
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
PUBLIC_ORIGIN=http://localhost:3000

# Facoltativo: relay TURN con credenziali temporanee (coturn use-auth-secret).
# Più URL separati da virgola. In produzione includere TURN su TCP/TLS.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# TURN_SHARED_SECRET=
