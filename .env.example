# Esempio delle variabili di ambiente lette dal progetto: i valori reali appartengono al file locale escluso da
# Git.
# Seleziona la modalità di esecuzione usata dalle impostazioni del server.
NODE_ENV=development
# Porta HTTP su cui Node.js avvia l’ascolto.
PORT=3000

# Host del database MySQL compatibile con TiDB.
DB_HOST=localhost
# Porta di collegamento al database.
DB_PORT=3306
# Nome dell’utente autorizzato sul database.
DB_USER=root
# Credenziale del database, da fornire nell’ambiente privato.
DB_PASSWORD=
# Database logico a cui collegare il pool.
DB_NAME=letsgosport
# Abilita o disabilita il collegamento TLS al database secondo la configurazione.
DB_SSL=false
# Numero massimo di connessioni contemporanee nel pool.
DB_CONNECTION_LIMIT=10

# Segreto usato dal backend per proteggere sessioni e firme previste dal progetto.
SESSION_SECRET=change-me-with-a-long-random-secret
# Credenziale del backend per verificare i token reCAPTCHA.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# Origine pubblica consentita dalla configurazione Socket.IO in produzione.
PUBLIC_ORIGIN=http://localhost:3000
# Numero di giorni oltre i quali la pulizia considera vecchi i messaggi.
MESSAGE_RETENTION_DAYS=15

# Archiviazione upload in produzione: bucket S3/R2 privato oppure disco persistente.
# MEDIA_S3_BUCKET=
# MEDIA_S3_ENDPOINT=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEDIA_DIR=/var/data/uploads
# Tetto del bucket S3/R2 in byte decimali: predefinito 8 GB. Richiede CREATE sul DB.
# MEDIA_STORAGE_LIMIT_BYTES=8000000000

# Facoltativo: Cloudflare Realtime TURN. Chiave TURN dedicata, diversa dai token R2.
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=
# TURN_ENABLED=true
# TURN_TTL_SECONDS=14400
# Per lo staging limitare il relay agli account di prova, separati da virgola.
# TURN_ALLOWED_EMAILS=primo@example.test,secondo@example.test

# In alternativa: relay coturn con credenziali temporanee (use-auth-secret).
# Più URL separati da virgola. In produzione includere TURN su TCP/TLS.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# TURN_SHARED_SECRET=
